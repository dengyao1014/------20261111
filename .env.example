# 二选一，和 config.yaml 里的 provider 对应
DEEPSEEK_API_KEY=sk-xxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 可选：覆盖 config.yaml
# DEMAND_PROVIDER=deepseek
# DEMAND_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# GitHub Issues 采集（不填则限 10 次搜索/分钟，够用）
# GITHUB_TOKEN=ghp_xxxxxxxx

# 竞品核实：填任意一个即可（Brave 有 2000 次/月免费额度）
# BRAVE_API_KEY=xxxxxxxx
# TAVILY_API_KEY=tvly-xxxxxxxx
# SERPER_API_KEY=xxxxxxxx

# 日报推送（都不填就只在本地生成）
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# TELEGRAM_BOT_TOKEN=123456:xxx
# TELEGRAM_CHAT_ID=123456789

# Reddit 需要代理
# HTTPS_PROXY=http://127.0.0.1:7890

# 如果你走 Anthropic 代理网关
# ANTHROPIC_BASE_URL=https://your-proxy.example.com
